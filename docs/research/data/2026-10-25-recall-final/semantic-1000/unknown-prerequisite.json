  "case": "unknown-prerequisite",
  "question": "Can we resume an incremental import using its old receipt?",
  "context": {},
  "finish": {
    "action": "finish",
    "paths": [
      "topics/r/429ebfbe-7713-40be-bca4-c3b904f82517-v1.md",
