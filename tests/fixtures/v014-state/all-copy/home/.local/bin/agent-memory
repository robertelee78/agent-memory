#!/bin/sh
old_ifs=$IFS
IFS=:
set -f
for dir in $PATH; do
  [ -n "$dir" ] || dir=.
  candidate=$dir/python3
  if [ -x "$candidate" ] && "$candidate" -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    IFS=$old_ifs
    exec "$candidate" -I -B -c 'import runpy,sys; sys.orig_argv=[sys.executable,sys.argv[1]]; sys.argv=sys.argv[1:]; runpy.run_path(sys.argv.pop(1),run_name="__main__")' "$0" @WORLD@/data/agent-memory/source/skills/agent-memory/scripts/installer.py "$@"
  fi
done
IFS=$old_ifs
printf '%s\n' 'am: Python 3.11+ must be available as python3 on PATH.' >&2
exit 1
